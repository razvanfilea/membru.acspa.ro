  "query": "select r._rowid_ as 'rowid!', r.created_for 'name!', r.date, r.hour, a.slots_start_minute as 'start_minute?', r.as_guest, r.in_waiting, r.created_at, u.name as created_by\n            from reservations r\n            inner join users u on r.user_id = u.id\n            left join alternative_days a on a.date = r.date\n            where r.created_for is not null and ($1 is null or r.date = $1)\n            order by r.date desc, r.hour, r.created_at desc",

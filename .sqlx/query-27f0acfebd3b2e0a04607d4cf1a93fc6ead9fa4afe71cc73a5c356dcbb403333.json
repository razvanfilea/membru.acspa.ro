  "query": "select r.date, r.hour, a.slots_start_minute as 'start_minute?', r.as_guest, r.cancelled, r.in_waiting, r.created_at from reservations as r\n             left join alternative_days a on a.date = r.date\n             where user_id = $1 and cancelled = $2 and created_for is null and strftime('%Y', r.date) = $3",
